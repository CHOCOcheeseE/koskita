# Salin ke .env lalu sesuaikan. Jangan commit .env.

# PostgreSQL lokal
DATABASE_URL="postgresql://koskita:koskita@localhost:5432/koskita?schema=public"

# Port HTTP backend
PORT=3000

# Rahasia tanda tangan access token JWT (isi string acak panjang, minimal 32 karakter)
JWT_ACCESS_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Umur token (default sesuai kontrak: access 15 menit, refresh 30 hari)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Cost bcrypt untuk hash kata sandi (default 10)
BCRYPT_ROUNDS=10

# Batas percobaan login/register per IP per jendela waktu
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_MS=60000

# Batas gabung grup lewat kode undangan per IP per jendela waktu
JOIN_THROTTLE_LIMIT=10
JOIN_THROTTLE_TTL_MS=60000

# Origin yang boleh memanggil API dari browser (pisahkan dengan koma, kosong = semua)
CORS_ORIGINS=
