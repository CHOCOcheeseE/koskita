{
  "name": "koskita-backend",
  "version": "0.1.0",
  "description": "Backend KosKita (NestJS + Prisma + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "gen:contract": "node scripts/gen-contract.mjs",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "openapi-typescript": "^7.9.1",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "typescript": "~5.8.3"
  },
  "jest": {
    "testTimeout": 30000,
    "projects": [
      {
        "displayName": "unit",
        "rootDir": ".",
        "testEnvironment": "node",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "testMatch": [
          "<rootDir>/src/**/*.spec.ts"
        ],
        "transform": {
          "^.+\\.ts$": "ts-jest"
        }
      },
      {
        "displayName": "e2e",
        "rootDir": ".",
        "testEnvironment": "node",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "testMatch": [
          "<rootDir>/test/**/*.e2e-spec.ts"
        ],
        "setupFiles": [
          "<rootDir>/test/support/env.ts"
        ],
        "transform": {
          "^.+\\.ts$": "ts-jest"
        }
      }
    ]
  }
}
