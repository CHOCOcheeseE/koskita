# Variabel untuk infra/docker-compose.yml (opsional, untuk nanti).
# Untuk jalan lokal tanpa Docker, yang dipakai adalah apps/backend/.env dan apps/mobile/.env
# (buat otomatis dengan: npm run setup:env).
#
# Pemakaian:  copy .env.example .env   lalu
#             docker compose --env-file .env -f infra/docker-compose.yml up --build
# Jangan commit .env.

# Akun dan nama database PostgreSQL di container
POSTGRES_USER=koskita
POSTGRES_PASSWORD=koskita
POSTGRES_DB=koskita

# Port PostgreSQL di laptop (5433 supaya tidak bentrok dengan PostgreSQL yang dipasang langsung)
POSTGRES_PORT=5433

# Port backend di laptop
BACKEND_PORT=3000

# Rahasia JWT backend, minimal 32 karakter acak. Buat dengan: npm run secret
JWT_ACCESS_SECRET=
